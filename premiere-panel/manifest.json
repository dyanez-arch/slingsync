{
  "manifestVersion": 5,
  "id": "io.github.slingsync.panel",
  "name": "SlingSync",
  "version": "0.10.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "27.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "slingsyncPanel",
      "label": {
        "default": "SlingSync"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 480
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    },
    "clipboard": "readAndWrite"
  }
}
